FLASK_SECRET_KEY=
SESSION_COOKIE_SECURE=false
AUTH_DATABASE=instance/user_accounts.sqlite3

# Rule-based mode is the safe default. Configure a key and model to enable OpenAI.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=20

# Optional privileged accounts; set both values for each account.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_AGENT_USERNAME=
BOOTSTRAP_AGENT_PASSWORD=
